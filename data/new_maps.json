{
 "_doc": "New maps/events for scripts/mapedit.py. Flag 0x14DB = became Champion (Mom's Ashida scene checks it). 55.1 = the Route 26 gate: west door (1,6) leads to Route 28 / Mt. Silver.",
 "scripts": {
  "silver_gate_pass": {
   "asm": "checkflag 0x14db\ngoto_if 1 pass\ngoto 0x087BE5AF\npass:\nreleaseall\nend"
  },
  "silver_guard_talk": {
   "asm": "checkflag 0x14db\ngoto_if 1 ok\ngoto 0x087BE6F7\nok:\nsay \"The path west leads to Mt. Silver.{FB}Only a Champion may go.{FB}Take care out there!\"\nend"
  },
  "silver_enter": {
   "asm": "lockall\ncheckflag 0x14db\ngoto_if 0 no\nwarp 58.0 32 12\nwaitstate\nend\nno:\nreleaseall\nend"
  },
  "ball_max_revive": {
   "asm": "setorcopyvar 0x8000 0x19\nsetorcopyvar 0x8001 1\ncallstd 1\nend"
  },
  "ball_pp_max": {
   "asm": "setorcopyvar 0x8000 0x47\nsetorcopyvar 0x8001 1\ncallstd 1\nend"
  },
  "ball_ultra": {
   "asm": "setorcopyvar 0x8000 0x2\nsetorcopyvar 0x8001 3\ncallstd 1\nend"
  },
  "ball_full_restore": {
   "asm": "setorcopyvar 0x8000 0x13\nsetorcopyvar 0x8001 1\ncallstd 1\nend"
  },
  "ball_protein": {
   "asm": "setorcopyvar 0x8000 0x40\nsetorcopyvar 0x8001 1\ncallstd 1\nend"
  },
  "ball_carbos": {
   "asm": "setorcopyvar 0x8000 0x42\nsetorcopyvar 0x8001 1\ncallstd 1\nend"
  },
  "ball_rare_candy": {
   "asm": "setorcopyvar 0x8000 0x44\nsetorcopyvar 0x8001 1\ncallstd 1\nend"
  },
  "ball_max_elixir": {
   "asm": "setorcopyvar 0x8000 0x25\nsetorcopyvar 0x8001 1\ncallstd 1\nend"
  },
  "red_talk": {
   "asm": "faceplayer\ntrainer 461 \"...\" \"...\"\nsay \"... ... ...\"\nend"
  },
  "to_summit": {
   "asm": "lockall\nsay \"A bitter wind blows down from above...\"\nwarp 58.4 49 50\nwaitstate\nend"
  },
  "from_summit": {
   "asm": "lockall\nwarp 58.3 7 13\nwaitstate\nend"
  }
 },
