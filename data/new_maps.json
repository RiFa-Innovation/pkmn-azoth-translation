{
 "_doc": "New maps/events for scripts/mapedit.py. Flag 0x14DB = became Champion (Mom's Ashida scene checks it). 55.1 = the Route 26 gate: west door (1,6) leads to Route 28 / Mt. Silver.",
 "scripts": {
  "silver_gate_pass": {
   "asm": "checkflag 0x14db\ngoto_if 1 pass\ngoto 0x087BE5AF\npass:\nreleaseall\nend"
  },
  "silver_guard_talk": {
   "asm": "checkflag 0x14db\ngoto_if 1 ok\ngoto 0x087BE6F7\nok:\nsay \"The path west leads to Mt. Silver.{FB}Only a Champion may go.{FB}Take care out there!\"\nend"
  },
  "silver_enter": {
   "asm": "lockall\ncheckflag 0x14db\ngoto_if 0 no\nwarp 58.0 8 10\nwaitstate\nend\nno:\nreleaseall\nend"
  },
  "ball_max_revive": {
   "asm": "setorcopyvar 0x8000 0x19\nsetorcopyvar 0x8001 1\ncallstd 1\nend"
  },
  "ball_pp_max": {
   "asm": "setorcopyvar 0x8000 0x47\nsetorcopyvar 0x8001 1\ncallstd 1\nend"
  },
  "ball_ultra": {
   "asm": "setorcopyvar 0x8000 0x2\nsetorcopyvar 0x8001 3\ncallstd 1\nend"
  },
  "ball_full_restore": {
   "asm": "setorcopyvar 0x8000 0x13\nsetorcopyvar 0x8001 1\ncallstd 1\nend"
  },
  "ball_protein": {
   "asm": "setorcopyvar 0x8000 0x40\nsetorcopyvar 0x8001 1\ncallstd 1\nend"
  },
  "ball_carbos": {
   "asm": "setorcopyvar 0x8000 0x42\nsetorcopyvar 0x8001 1\ncallstd 1\nend"
  },
  "ball_rare_candy": {
   "asm": "setorcopyvar 0x8000 0x44\nsetorcopyvar 0x8001 1\ncallstd 1\nend"
  },
  "ball_max_elixir": {
   "asm": "setorcopyvar 0x8000 0x25\nsetorcopyvar 0x8001 1\ncallstd 1\nend"
  },
  "red_talk": {
   "asm": "faceplayer\ntrainer 461 \"...\" \"...\"\nsay \"... ... ...\"\nend"
  },
  "to_summit": {
   "asm": "lockall\nsay \"A bitter wind blows down from above...\"\nwarp 58.4 49 50\nwaitstate\nend"
  },
  "from_summit": {
   "asm": "lockall\nwarp 58.3 7 13\nwaitstate\nend"
  },
  "silver_nurse": {
   "asm": "faceplayer\nsay \"Welcome to the Mt. Silver rest stop!{FB}Let me restore your Pok\u00e9mon to full health.\"\nfadescreen 1\nplayfanfare 0x100\nwaitfanfare\nspecial 0\nfadescreen 0\nsay \"Your Pok\u00e9mon are fully healed.{FB}Be careful up there!\"\nend"
  },
  "tr_48": {
   "asm": "trainer 48 \"Mt. Silver is no place for the unprepared!\" \"My rocks crumbled...\"\nsay \"Beyond here the cave never sleeps.\"\nend"
  },
  "tr_49": {
   "asm": "trainer 49 \"My birds rule these skies!\" \"Grounded...\"\nsay \"The peak is where the wind turns.\"\nend"
  },
  "tr_62": {
   "asm": "trainer 62 \"Hah! Show me your guts!\" \"Good fight...\"\nsay \"Train your body as well as your team.\"\nend"
  },
  "tr_77": {
   "asm": "trainer 77 \"I saw you coming in a dream.\" \"I did not foresee this...\"\nsay \"The sun and the moon both watch you.\"\nend"
  },
  "tr_113": {
   "asm": "trainer 113 \"I dig the dark. You?\" \"Struck rock bottom...\"\nsay \"Mind the loose stone ahead.\"\nend"
  },
  "tr_200": {
   "asm": "trainer 200 \"Fly or fall!\" \"I fell!\"\nsay \"Higher floors have stranger winds.\"\nend"
  },
  "tr_454": {
   "asm": "trainer 454 \"Dragons answer only to the worthy!\" \"You tamed them...\"\nsay \"Go on. The summit awaits.\"\nend"
  },
  "tr_455": {
   "asm": "trainer 455 \"Few reach this floor. Fewer leave it.\" \"Impressive...\"\nsay \"Red waits where the air is thinnest.\"\nend"
  }
 },
